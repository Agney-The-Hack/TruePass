# TruePass Server Environment Configuration
PORT=4000

# Privacy & Biometric Commitment (Requirement 2)
# Server-side secret key used to salt per-event biometric commitments.
# NEVER expose this secret to frontend clients or git repositories.
BIOMETRIC_SALT_SECRET=truepass_biometric_salt_secret_entropy_2026_supersecure

# Dev / Testing Mode Flag (Requirement 4)
# When set to true, allows deterministic mock tokens for local testing without camera/ML model.
MOCK_BIOMETRICS=true

# Smart Contract & Web3 Relayer Configuration (Requirement 3)
TRUE_PASS_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
RPC_URL=http://127.0.0.1:8545
# Anvil / Hardhat Account #0 default private key for local development
RELAYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Razorpay Webhook Secret (Requirement 3)
# Matches the secret configured on the Razorpay Dashboard -> Webhooks
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_truepass_test_2026
